{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24.22.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"paraglide": "paraglide-js compile --silent --emit-ts-declarations --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@inlang/paraglide-js": "2.29.0",
		"@inlang/plugin-message-format": "4.5.4",
		"@playwright/test": "1.64.1",
		"@storybook/addon-a11y": "10.6.2",
		"@storybook/addon-docs": "10.6.2",
		"@storybook/addon-svelte-csf": "5.1.5",
		"@storybook/addon-vitest": "10.6.2",
		"@storybook/svelte": "10.6.2",
		"@storybook/sveltekit": "10.6.2",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/mdast": "4.0.4",
		"@types/node": "24.19.2",
		"@vitest/browser-playwright": "4.1.12",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-storybook": "10.6.2",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"playwright": "1.64.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"storybook": "10.6.2",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "4.1.12"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@elastic/ecs-pino-format": "1.5.0",
		"@modelcontextprotocol/server": "2.3.1",
		"croner": "10.0.1",
		"mdast-util-to-string": "4.0.0",
		"pino": "10.4.0",
		"pino-pretty": "13.2.0",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-stringify": "11.0.0",
		"smol-toml": "1.9.1",
		"unified": "11.0.5",
		"unist-util-visit": "5.2.0",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	}
}
