# Copy to .env for `make dev`; .env is not committed.

# Path of the SQLite file, relative to app/. Its directory is the volume in production;
# the file and its -wal and -shm companions are created there on first start.
DATABASE_PATH=data/grimoire.db

# Key encrypting the Git access tokens of sources: 32 random bytes, base64.
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# With true, migrate the database and exit without serving.
MIGRATE_ONLY=false

# When sources without their own schedule are checked for new commits: cron expression with
# five fields (minute hour day month weekday), in the time zone TZ. Default every 5 minutes.
SYNC_SCHEDULE="*/5 * * * *"

# Time zone of the instance, an IANA name: schedules run in it and the UI shows times in it.
# Default UTC.
TZ=UTC

# Log format: ecs (one JSON object per line, Elastic Common Schema; the default) or pretty
# (readable text for local development).
LOG_FORMAT=pretty

# Lowest level that is written: error, warn, info (the default) or debug.
LOG_LEVEL=info
