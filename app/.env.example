# Copy to .env for `make dev`; .env is not committed.

# Path of the SQLite file, relative to app/. Created with its schema on first start.
DATABASE_PATH=grimoire.db

# Key encrypting the Git access tokens of sources: 32 random bytes, base64.
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# With true, migrate the database and exit without serving.
MIGRATE_ONLY=false
