# Copy to .env for `make dev`; .env is not committed.

# Path of the SQLite file, relative to app/. Its directory is the volume in production;
# the file and its -wal and -shm companions are created there on first start.
DATABASE_PATH=data/grimoire.db

# Key encrypting the Git access tokens of sources: 32 random bytes, base64.
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# With true, migrate the database and exit without serving.
MIGRATE_ONLY=false

# When sources without their own schedule are checked for new commits: cron expression with
# five fields (minute hour day month weekday), server time zone. Default every 5 minutes.
SYNC_SCHEDULE="*/5 * * * *"
